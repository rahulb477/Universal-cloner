# Universal Website Cloner Studio: environment variables.
# Copy to .env (never commit .env). Everything is optional for local use.

# --- Database -------------------------------------------------------------
# PostgreSQL connection string. Leave empty to use the embedded PostgreSQL
# (PGlite) stored on disk under STUDIO_DATA_DIR/pglite.
DATABASE_URL=

# --- Storage --------------------------------------------------------------
# Where the studio keeps its database (PGlite), generated projects, logs,
# analysis output and ZIP exports. Must be a persistent, writable directory.
# Default: ./data
STUDIO_DATA_DIR=

# --- Secrets --------------------------------------------------------------
# Master secret (16+ characters) used to encrypt AI provider keys and
# test-account passwords (AES-256-GCM) and to sign session cookies.
# If empty, a random key file is created at STUDIO_DATA_DIR/.studio-secret.
# Generate one with:  openssl rand -base64 48
STUDIO_SECRET=
# Set to "true" to refuse to start encrypting without STUDIO_SECRET in production.
STUDIO_REQUIRE_SECRET=

# Password for the studio UI and API. When empty the studio is OPEN to anyone
# who can reach it: set this for any deployment that is not on localhost.
STUDIO_PASSWORD=

# --- Network policy -------------------------------------------------------
# The crawler refuses private, loopback and link-local addresses (SSRF
# protection). To clone a site on your own machine or network, list its exact
# host:port here (comma separated), for example: 127.0.0.1:4599,localhost:8080
STUDIO_ALLOW_PRIVATE_TARGETS=
# Set to "true" to allow custom AI endpoints on local/private addresses
# (for example Ollama or LM Studio at http://127.0.0.1:11434/v1).
STUDIO_ALLOW_LOCAL_AI=

# --- Browser --------------------------------------------------------------
# Path to a Chrome/Chromium binary. When empty the studio uses a browser
# installed with `npx playwright install chromium`, and otherwise the
# Chromium build bundled in @sparticuz/chromium (Linux x64).
CHROMIUM_EXECUTABLE_PATH=

# --- Live previews --------------------------------------------------------
# Previews are served by a separate listener so they run on a different
# origin than the studio. Default port: 4100. (4190 is rejected by fetch().)
PREVIEW_PORT=
# Interface for that listener. Default: 0.0.0.0
PREVIEW_HOST=
# Set to "off" to disable the separate listener. Previews are then served by
# the studio itself at /preview/<token>/ with a sandboxing CSP.
PREVIEW_GATEWAY=
# Public origin of the preview listener when it sits behind a proxy or its
# own domain, for example https://previews.example.com
PREVIEW_PUBLIC_ORIGIN=

# AI provider API keys are NOT configured here. Add them in the studio under
# "AI Providers"; they are stored encrypted in the database.
